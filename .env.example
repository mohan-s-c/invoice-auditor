# Copy to .env and fill. NEVER commit real secrets.

# --- Local LLM (self-hosted Qwen). Default offline = deterministic, no GPU needed. ---
LLM_PROVIDER=offline                 # offline | oss
OSS_MODEL_BASE_URL=http://localhost:11434/v1   # vLLM/Ollama OpenAI-compatible endpoint
OSS_MODEL_NAME=qwen2.5:7b
# GUARDRAIL: financial/PII data must stay on local models. Keep false.
ALLOW_EXTERNAL_MODEL=false

# --- AP / invoicing tool (separate from TRACK). Default mock until confirmed. ---
AP_MODE=mock                         # mock | api | ramp
AP_BASE_URL=
AP_API_KEY=

# --- Ramp ingestion (AP_MODE=ramp). Falls back to seed if unset. NEVER commit secrets. ---
RAMP_BASE_URL=https://api.ramp.com
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# --- Email notifications. Default offline = queue to outbox, never send. ---
NOTIFY_PROVIDER=offline              # offline | graph | smtp
# GUARDRAIL: a real provider only sends when this is explicitly true. Keep false for demos.
ALLOW_EXTERNAL_EMAIL=false
NOTIFY_FROM=invoice-auditor@awayday.example
# Microsoft Graph (M365) — client-credentials:
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# SMTP (Google Workspace / M365 / relay):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- State (offline; SQLite). ---
DB_PATH=invoice_auditor.db
